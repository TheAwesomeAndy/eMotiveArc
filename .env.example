# EmotiveArc website configuration.
# Copy to .env.local for local development. Set real values in the Vercel
# project settings. Never commit real values. .env* files are gitignored.

# --- Site stage -------------------------------------------------------------
# "preview" (default): preview ribbon + noindex/robots disallow.
# "live": only after the founder approves publication.
NEXT_PUBLIC_SITE_STAGE=preview

# Canonical URL used for metadata, sitemap and Open Graph.
# Leave unset until the domain is cleared. Vercel URLs are used as fallback.
# NEXT_PUBLIC_SITE_URL=https://emotivearc.com

# Public contact address. Leave unset until the mailbox exists and is monitored.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@emotivearc.com

# Optional booking link for discovery calls (e.g. a Cal.com page).
# NEXT_PUBLIC_DISCOVERY_CALL_URL=

# --- Inquiry delivery (server-only, never exposed to the browser) -----------
# Option A: email via Resend (https://resend.com). All three are required.
# CONTACT_FROM_EMAIL must be on a domain verified in Resend.
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=hello@emotivearc.com
# CONTACT_FROM_EMAIL=EmotiveArc Website <inquiries@emotivearc.com>

# Option B: POST each inquiry as JSON to a webhook (Zapier, Make, Slack, etc).
# Used only if Option A is not fully configured.
# CONTACT_WEBHOOK_URL=
# CONTACT_WEBHOOK_SECRET=

# With neither option set, the form runs in visible preview mode: it
# validates, logs the submission to the server log, and tells the visitor
# plainly that nothing was delivered.

# --- Analytics (off by default; enable only after founder approval) ---------
# NEXT_PUBLIC_ANALYTICS_PROVIDER=plausible
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=emotivearc.com
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
