# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------
# EmotiveArc: never commit secrets, client data, or research data
# ---------------------------------------------------------------
# Env files are ignored above (.env*). Only the template is allowed.
!.env.example

# Private MotiveLab research, evaluation infrastructure, and datasets
# belong in a separate private repository, never here.
/motivelab/
/MotiveLab/
/research/
/private/
/datasets/
/experiments/
/evaluations/
/client-data/
/clients/
/transcripts/
*.jsonl
*.parquet
*.sqlite
*.db

# Local browser test output
/test-results/
/playwright-report/
